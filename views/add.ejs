<%- include('partials/header') %>

<main class="container" style="margin-top: 20px; max-width: 600px;">
  <h1>Добавить новый эпизод</h1>

  <form action="/add<%= user && user.role === 'admin' ? '?auth=1' : '' %>" method="POST" style="display: flex; flex-direction: column; gap: 15px; margin-top: 20px;">
    <div>
      <label style="display: block; margin-bottom: 5px;">Название эпизода:</label>
      <input type="text" name="title" required style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
    </div>

    <div>
      <label style="display: block; margin-bottom: 5px;">Название подкаста:</label>
      <input type="text" name="podcastName" required style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
    </div>

    <div>
      <label style="display: block; margin-bottom: 5px;">Длительность (в минутах):</label>
      <input type="number" name="durationMinutes" required style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
    </div>

    <div>
      <label style="display: block; margin-bottom: 5px;">Ссылка на аудиофайл (URL):</label>
      <input type="url" name="audioUrl" required style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
    </div>

    <div>
      <label style="display: block; margin-bottom: 5px;">Описание:</label>
      <textarea name="description" rows="4" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;"></textarea>
    </div>

    <div>
      <label>
        <input type="checkbox" name="isExplicit">
        Контент 18+ (Explicit)
      </label>
    </div>

    <button type="submit" style="background: #28a745; color: white; padding: 10px; border: none; border-radius: 4px; cursor: pointer; font-size: 16px;">
      Сохранить эпизод
    </button>
  </form>
</main>

<%- include('partials/footer') %>