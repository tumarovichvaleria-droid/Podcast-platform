<%- include('partials/header') %>

<main style="max-width: 520px; margin: 40px auto; padding: 0 15px;">
  <div style="background: #ffffff; border: 1px solid #eef0f2; border-radius: 16px; padding: 36px 30px; box-shadow: 0 4px 18px rgba(0,0,0,0.04);">
    
    <div style="text-align: center; margin-bottom: 24px;">
      <div style="display: inline-flex; align-items: center; justify-content: center; width: 60px; height: 60px; background: #eff6ff; color: #2563eb; border-radius: 50%; margin-bottom: 12px;">
        <i class="bi bi-plus-circle" style="font-size: 26px;"></i>
      </div>
      <h2 style="font-size: 22px; font-weight: 700; color: #0f172a; margin: 0 0 4px 0;">Добавить новый эпизод</h2>
      <p style="color: #64748b; font-size: 13px; margin: 0;">Заполните информацию о новом выпуске подкаста</p>
    </div>

    <!-- Блок вывода ошибки -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background-color: #fef2f2; border: 1px solid #fecaca; color: #dc2626; padding: 12px 16px; border-radius: 8px; font-size: 14px; margin-bottom: 20px;">
        <%= error %>
      </div>
    <% } %>

    <form action="/add<%= user && user.role === 'admin' ? '?auth=1' : '' %>" method="POST">
      
      <!-- Название эпизода (макс 50 символов) -->
      <div style="margin-bottom: 16px;">
        <label style="display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 6px;">Название эпизода</label>
        <div style="position: relative;">
          <input type="text" name="title" required 
                 minlength="1" maxlength="50" 
                 pattern=".*\S.*" title="Поле не должно состоять только из пробелов"
                 style="width: 100%; padding: 10px 14px 10px 38px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box;">
          <i class="bi bi-mic" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8;"></i>
        </div>
      </div>

      <!-- Название подкаста (макс 50 символов) -->
      <div style="margin-bottom: 16px;">
        <label style="display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 6px;">Название подкаста</label>
        <div style="position: relative;">
          <input type="text" name="podcastName" required 
                 minlength="1" maxlength="50" 
                 pattern=".*\S.*" title="Поле не должно состоять только из пробелов"
                 style="width: 100%; padding: 10px 14px 10px 38px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box;">
          <i class="bi bi-broadcast" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8;"></i>
        </div>
      </div>

      <!-- Длительность (целое положительное число, без точек, запятых и знаков) -->
<div style="margin-bottom: 16px;">
  <label style="display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 6px;">Длительность (в минутах)</label>
  <div style="position: relative;">
    <input type="number" name="durationMinutes" required 
           min="1" max="9999" step="1" maxlength="4"
           onkeydown="if(['-', '+', 'e', 'E', '.', ','].includes(event.key)) event.preventDefault();"
           oninput="if(this.value.length > 4) this.value = this.value.slice(0, 4); if(this.value < 1 && this.value !== '') this.value = '';"
           style="width: 100%; padding: 10px 14px 10px 38px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box;">
    <i class="bi bi-clock" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8;"></i>
  </div>
</div>

      <!-- URL аудио -->
      <div style="margin-bottom: 16px;">
        <label style="display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 6px;">Ссылка на аудиофайл (URL)</label>
        <div style="position: relative;">
          <input type="url" name="audioUrl" required maxlength="70"
                 style="width: 100%; padding: 10px 14px 10px 38px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box;">
          <i class="bi bi-link-45deg" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8;"></i>
        </div>
      </div>

      <!-- Описание (макс 50 символов) -->
      <div style="margin-bottom: 16px;">
        <label style="display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 6px;">Описание</label>
        <div style="position: relative;">
          <textarea name="description" rows="3" maxlength="50" placeholder="Краткое описание" style="width: 100%; padding: 10px 14px 10px 38px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box; resize: vertical;"></textarea>
          <i class="bi bi-file-text" style="position: absolute; left: 12px; top: 12px; color: #94a3b8;"></i>
        </div>
      </div>

      <!-- Флаг 18+ -->
      <div style="margin-bottom: 24px;">
        <label style="display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: #475569; cursor: pointer;">
          <input type="checkbox" name="isExplicit" style="width: 16px; height: 16px; accent-color: #2563eb; cursor: pointer;">
          <span>18+</span>
        </label>
      </div>

      <button type="submit" style="width: 100%; background: #7532b5; color: #ffffff; font-weight: 600; font-size: 14px; padding: 12px; border: none; border-radius: 8px; cursor: pointer; transition: background 0.2s ease; display: flex; align-items: center; justify-content: center; gap: 8px;">
        <i class="bi bi-check-circle" style="font-size: 16px;"></i>
        <span>Сохранить эпизод</span>
      </button>

    </form>
  </div>
</main>

<%- include('partials/footer') %>