<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <!-- Подключение векторных иконок -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
 <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <% const authQuery = user && user.role === 'admin' ? '?auth=1' : ''; %>

  <header class="site-header">
    <nav>
      <div class="nav-left">
        <a href="/" class="nav-link">
          <i class="bi bi-collection-play"></i> Главная
        </a>
        <% if (user && user.role === 'admin') { %>
        <a href="/add" class="nav-link">
          <i class="bi bi-plus-circle"></i> Добавить эпизод
        </a>
        <% } %>
      </div>

      <div class="auth-info">
        <% if (user && user.role && user.role !== 'guest') { %>
          <div class="user-badge">
            <i class="bi bi-person-circle"></i>
            <span><%= user.email || user.name || 'Авторизован' %></span>
          </div>
          <a href="/logout" class="btn-auth btn-logout">
            <i class="bi bi-box-arrow-right"></i> Выйти
          </a>
        <% } else { %>
          <div class="user-badge">
            <i class="bi bi-person"></i>
            <span>Гость</span>
          </div>
          <a href="/login" class="btn-auth btn-login">
            <i class="bi bi-box-arrow-in-right"></i> Войти
          </a>
        <% } %>
      </div>
    </nav>
  </header>

  <!-- Главный блок страницы -->
  <main class="main-content">
