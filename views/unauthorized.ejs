<%- include('partials/header') %>

<main class="container" style="max-width: 500px; margin: 60px auto; padding: 0 15px;">
  <div style="background: #ffffff; border: 1px solid #eef0f2; border-radius: 12px; padding: 40px 30px; text-align: center; box-shadow: 0 4px 16px rgba(0,0,0,0.06);">
    
    <h2 style="font-size: 22px; font-weight: 700; color: #1a1a1a; margin: 0 0 10px 0;">
      Требуется авторизация
    </h2>
    
    <p style="color: #666; font-size: 14px; line-height: 1.5; margin: 0 0 25px 0;">
      Для добавления новых эпизодов необходимо войти в систему.
    </p>

    <div style="display: flex; gap: 12px; justify-content: center;">
      <a href="/login" class="btn" style="background: #0066ff; color: white; padding: 10px 24px; border-radius: 6px; text-decoration: none; font-weight: 600;">
        <i class="bi bi-box-arrow-in-right"></i> Войти
      </a>
      <a href="/" style="background: #f1f3f5; color: #495057; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: 600;">
