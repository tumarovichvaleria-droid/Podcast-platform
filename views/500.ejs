<%- include('partials/header') %>

<div style="max-width: 560px; margin: 40px auto; text-align: center;">
  <div style="background: #ffffff; border: 1px solid #eef0f2; border-radius: 16px; padding: 40px 30px; box-shadow: 0 4px 18px rgba(0,0,0,0.04);">
    
   
    <div style="display: inline-flex; align-items: center; justify-content: center; width: 72px; height: 72px; background: #fef2f2; color: #dc2626; border-radius: 50%; margin-bottom: 20px;">
      <i class="bi bi-exclamation-octagon-fill" style="font-size: 32px;"></i>
    </div>

    <div style="display: inline-block; background: #fee2e2; color: #b91c1c; font-size: 13px; font-weight: 700; padding: 4px 12px; border-radius: 20px; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
      Ошибка 500
    </div>

    <h1 style="font-size: 22px; font-weight: 700; color: #0f172a; margin: 0 0 10px 0; line-height: 1.3;">
      Внутренняя ошибка сервера
    </h1>

    <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin: 0 0 24px 0;">
      Произошел непредвиденный сбой при обработке вашего запроса. Мы уже работаем над исправлением.
    </p>

    <!-- Детали ошибки (если доступны) -->
    <% if (locals.error) { %>
      <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 16px; margin-bottom: 24px; text-align: left;">
        <div style="font-size: 12px; font-weight: 600; color: #64748b; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
          <i class="bi bi-bug-fill"></i> Технические детали:
        </div>
        <code style="font-family: monospace; font-size: 13px; color: #dc2626; word-break: break-all;">
          <%= error %>
        </code>
      </div>
    <% } %>

    <!-- Кнопки действий -->
    <div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
      <a href="/" style="display: inline-flex; align-items: center; gap: 8px; background: #2563eb; color: #ffffff; font-weight: 600; font-size: 14px; padding: 11px 22px; border-radius: 8px; text-decoration: none; transition: background 0.2s ease;">
        <i class="bi bi-house-door-fill"></i> На главную
      </a>
      <button onclick="window.location.reload()" style="display: inline-flex; align-items: center; gap: 8px; background: #f1f5f9; color: #334155; border: none; font-weight: 600; font-size: 14px; padding: 11px 20px; border-radius: 8px; cursor: pointer; transition: background 0.2s ease;">
        <i class="bi bi-arrow-clockwise"></i> Обновить
      </button>
    </div>

  </div>
</div>

<%- include('partials/footer') %>