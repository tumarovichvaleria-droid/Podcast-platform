<%- include('partials/header') %>

<div style="background: #ffffff; border: 1px solid #eef0f2; border-radius: 16px; padding: 32px; box-shadow: 0 4px 18px rgba(0,0,0,0.04);">
  
  <!-- Название подкаста (бейджик) -->
  <span style="display: inline-flex; align-items: center; gap: 6px; color: #2563eb; font-weight: 600; font-size: 13px; background: #eff6ff; padding: 6px 14px; border-radius: 20px;">
    <i class="bi bi-mic-fill"></i> <%= episode.podcastName %>
  </span>

  <!-- Заголовок эпизода -->
  <h1 style="font-size: 26px; font-weight: 700; color: #0f172a; margin: 16px 0 20px 0; line-height: 1.3;">
    <%= episode.title %>
  </h1>

  <!-- Блок с характеристиками и ссылкой -->
  <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 28px;">
    
    <!-- Первая строка: длительность, прослушивания, ограничение -->
    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
      
      <!-- Длительность -->
      <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px 14px; font-size: 13px; color: #475569; display: flex; align-items: center; gap: 6px; font-weight: 500;">
        <i class="bi bi-clock-history" style="color: #64748b;"></i>
        <span><%= episode.durationMinutes %> мин.</span>
      </div>

      <!-- Прослушивания -->
      <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px 14px; font-size: 13px; color: #475569; display: flex; align-items: center; gap: 6px; font-weight: 500;">
        <i class="bi bi-headphones" style="color: #64748b;"></i>
        <span>Прослушиваний: <%= episode.playsCount %></span>
      </div>

      <!-- Возрастное ограничение -->
      <% if (episode.isExplicit) { %>
        <div style="background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; border-radius: 8px; padding: 8px 14px; font-size: 13px; display: flex; align-items: center; gap: 6px; font-weight: 600;">
          <i class="bi bi-exclamation-triangle-fill"></i>
          <span>18+</span>
        </div>
      <% } else { %>
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; color: #475569; border-radius: 8px; padding: 8px 14px; font-size: 13px; display: flex; align-items: center; gap: 6px; font-weight: 500;">
          <i class="bi bi-shield-check" style="color: #16a34a;"></i>
          <span>Без ограничений</span>
        </div>
      <% } %>

    </div>

    <!-- Вторая строка: Источник и ссылка -->
    <% if (episode.audioUrl) { %>
      <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 14px; font-size: 13px; display: flex; align-items: center; gap: 8px; width: fit-content; max-width: 100%;">
        <i class="bi bi-link-45deg" style="color: #2563eb; font-size: 16px; flex-shrink: 0;"></i>
        <span style="font-weight: 600; color: #334155; flex-shrink: 0;">Источник:</span>
        <a href="<%= episode.audioUrl %>" target="_blank" style="color: #2563eb; text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= episode.audioUrl %></a>
      </div>
    <% } %>

  </div>

  <!-- Описание -->
  <div style="margin-bottom: 28px;">
    <h3 style="font-size: 15px; font-weight: 600; color: #334155; margin: 0 0 10px 0; display: flex; align-items: center; gap: 8px;">
      <i class="bi bi-file-text" style="color: #2563eb;"></i> Описание
    </h3>
    <p style="color: #475569; line-height: 1.6; font-size: 15px; margin: 0; background: #fafafa; padding: 16px; border-radius: 10px; border: 1px solid #f1f5f9;">
      <%= episode.description %>
    </p>
  </div>

  <!-- Аудиоплеер -->
  <% if (episode.audioUrl) { %>
    <div style="background: #f1f5f9; border-radius: 12px; padding: 16px; margin-top: 20px;">
      <audio controls style="width: 100%;">
        <source src="<%= episode.audioUrl %>" type="audio/mpeg">
        Ваш браузер не поддерживает аудиоэлемент.
      </audio>
    </div>
  <% } %>

  <!-- Кнопка возврата -->
  <div style="margin-top: 32px; padding-top: 20px; border-top: 1px solid #f1f5f9;">
    <a href="/" style="display: inline-flex; align-items: center; gap: 8px; background: #f1f5f9; color: #334155; font-weight: 600; font-size: 14px; padding: 10px 18px; border-radius: 8px; text-decoration: none; transition: all 0.2s ease;">
      <i class="bi bi-arrow-left"></i> Назад к списку
    </a>
  </div>

</div>

<%- include('partials/footer') %>